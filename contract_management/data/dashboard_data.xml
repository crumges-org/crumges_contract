<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <record id="template_sale_invoice" model="contract.template">
            <field name="name">Contratos de facturas de venta</field>
            <field name="contract_type">sale</field>
            <field name="generation_type">invoice</field>
            <field name="color">2</field>
        </record>

        <record id="template_purchase_invoice" model="contract.template">
            <field name="name">Contratos de facturas de compra</field>
            <field name="contract_type">purchase</field>
            <field name="generation_type">invoice</field>
            <field name="color">3</field>
        </record>

        <record id="template_sale_order" model="contract.template">
            <field name="name">Contratos de venta (Pedidos)</field>
            <field name="contract_type">sale</field>
            <field name="generation_type">sale</field>
            <field name="color">4</field>
        </record>

    </data>
</odoo>
