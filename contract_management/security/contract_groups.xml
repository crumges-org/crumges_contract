<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Technical groups for settings -->
    <record id="group_contract_template" model="res.groups">
        <field name="name">Use Contract Templates</field>
        <field name="category_id" ref="base.module_category_hidden" />
    </record>

    <record id="group_contract_tag" model="res.groups">
        <field name="name">Use Contract Tags</field>
        <field name="category_id" ref="base.module_category_hidden" />
    </record>

    <record id="group_contract_line_recurrence" model="res.groups">
        <field name="name">Use Line Level Recurrence</field>
        <field name="category_id" ref="base.module_category_hidden" />
    </record>

    <record id="group_contract_modification_rule" model="res.groups">
        <field name="name">Use Automatic Change Management</field>
        <field name="category_id" ref="base.module_category_hidden" />
    </record>

    <!-- Generation Feature Toggles -->
    <record id="group_contract_sale_invoice" model="res.groups">
        <field name="name">Generate Sale Invoices</field>
        <field name="category_id" ref="base.module_category_hidden" />
    </record>

    <record id="group_contract_sale_order" model="res.groups">
        <field name="name">Generate Sale Orders</field>
        <field name="category_id" ref="base.module_category_hidden" />
    </record>

    <record id="group_contract_purchase_invoice" model="res.groups">
        <field name="name">Generate Purchase Invoices</field>
        <field name="category_id" ref="base.module_category_hidden" />
    </record>

    <!-- Advanced Invoicing Toggles -->
    <record id="group_contract_invoice_auto_validate" model="res.groups">
        <field name="name">Auto Validate Contract Invoices</field>
        <field name="category_id" ref="base.module_category_hidden" />
    </record>

    <!-- Rules for Dashboard Cards Visibility -->
    <record id="rule_dashboard_sale_invoice" model="ir.rule">
        <field name="name">Show Sale Invoice Card</field>
        <field name="model_id" ref="model_contract_dashboard_card"/>
        <field name="domain_force">[('code', '!=', 'sale_invoice')]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="rule_dashboard_sale_invoice_allow" model="ir.rule">
        <field name="name">Show Sale Invoice Card (Allowed)</field>
        <field name="model_id" ref="model_contract_dashboard_card"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('contract_management.group_contract_sale_invoice'))]"/>
    </record>

    <record id="rule_dashboard_sale_order" model="ir.rule">
        <field name="name">Show Sale Order Card</field>
        <field name="model_id" ref="model_contract_dashboard_card"/>
        <field name="domain_force">[('code', '!=', 'sale_order')]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="rule_dashboard_sale_order_allow" model="ir.rule">
        <field name="name">Show Sale Order Card (Allowed)</field>
        <field name="model_id" ref="model_contract_dashboard_card"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('contract_management.group_contract_sale_order'))]"/>
    </record>

    <record id="rule_dashboard_purchase_invoice" model="ir.rule">
        <field name="name">Show Purchase Invoice Card</field>
        <field name="model_id" ref="model_contract_dashboard_card"/>
        <field name="domain_force">[('code', '!=', 'purchase_invoice')]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="rule_dashboard_purchase_invoice_allow" model="ir.rule">
        <field name="name">Show Purchase Invoice Card (Allowed)</field>
        <field name="model_id" ref="model_contract_dashboard_card"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('contract_management.group_contract_purchase_invoice'))]"/>
    </record>

</odoo>
