<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Config Settings View -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field
            name="name"
        >res.config.settings.view.form.inherit.contract.management</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90" />
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app
                    data-string="Contratos"
                    string="Contratos"
                    name="contract_management"
                    groups="base.group_system"
                >
                    <block
                        title="Características Opcionales"
                        name="contract_optional_features"
                    >
                        <setting
                            id="contract_template_setting"
                            help="Permite crear y utilizar plantillas base para nuevos contratos."
                        >
                            <field name="group_contract_template" />
                        </setting>
                        <setting
                            id="contract_tag_setting"
                            help="Permite categorizar los contratos usando etiquetas personalizadas."
                        >
                            <field name="group_contract_tag" />
                        </setting>
                        <setting
                            id="contract_line_recurrence_setting"
                            help="Permite configurar reglas de facturación diferentes para cada línea individual de un contrato."
                        >
                            <field name="group_contract_line_recurrence" />
                        </setting>
                        <setting
                            id="contract_modification_rule_setting"
                            help="Habilita la gestión de reglas automáticas para aplicar cambios en lote a múltiples contratos."
                        >
                            <field name="group_contract_modification_rule" />
                        </setting>
                        <setting
                            id="contract_variable_qty_prorated_setting"
                            help="Permite aplicar reglas de prorrateo a consumos o plantillas de variables a mitad de mes."
                        >
                            <field name="module_contract_variable_qty_prorated" />
                        </setting>
                    </block>
                    <block
                        title="Motores de Generación"
                        name="contract_generation_engines"
                    >
                        <setting
                            id="contract_sale_invoice_setting"
                            help="Permite generar recurrentemente Facturas de Venta a clientes."
                        >
                            <field name="group_contract_sale_invoice" />
                        </setting>
                        <setting
                            id="contract_sale_order_setting"
                            help="Permite generar recurrentemente Pedidos de Venta a clientes."
                        >
                            <field name="group_contract_sale_order" />
                            <div
                                class="content-group"
                                invisible="not group_contract_sale_order"
                            >
                                <div class="mt8 text-muted">
                                    <field
                                        name="module_contract_sale_generation"
                                        invisible="1"
                                    />

                                </div>
                            </div>
                        </setting>
                        <setting
                            id="contract_purchase_invoice_setting"
                            help="Permite generar recurrentemente Facturas de Compra de proveedores."
                        >
                            <field name="group_contract_purchase_invoice" />
                        </setting>
                    </block>

                    <block title="Vistas Adicionales" name="contract_additional_views">
                        <setting
                            id="contract_gantt_setting"
                            help="Habilita la Vista de Línea de Tiempo / Gantt para visualización de contratos."
                        >
                            <field name="enable_gantt_view" />
                            <div
                                class="content-group mt16"
                                invisible="not enable_gantt_view"
                            >
                                <div class="row">
                                    <label
                                        for="gantt_view_type"
                                        class="col-lg-3 o_light_label"
                                    />
                                    <field
                                        name="gantt_view_type"
                                        required="enable_gantt_view"
                                    />
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <!-- Action for Config Settings -->
    <record id="action_contract_config_settings" model="ir.actions.act_window">
        <field name="name">Ajustes</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field
            name="context"
        >{'module' : 'contract_management', 'bin_size': False}</field>
    </record>

    <!-- Menu Item for Config Settings -->
    <menuitem
        id="menu_contract_config_settings"
        name="Ajustes"
        parent="contract_management.contract_menu_config"
        sequence="0"
        action="action_contract_config_settings"
        groups="base.group_system"
    />
</odoo>
