<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_contract_modification_rule_tree" model="ir.ui.view">
        <field name="name">contract.modification.rule.tree</field>
        <field name="model">contract.modification.rule</field>
        <field name="arch" type="xml">
            <list string="Reglas de Auditoría">
                <field name="name"/>
                <field name="model_id"/>
                <field name="field_id"/>
                <field name="action_type"/>
            </list>
        </field>
    </record>

    <record id="view_contract_modification_rule_form" model="ir.ui.view">
        <field name="name">contract.modification.rule.form</field>
        <field name="model">contract.modification.rule</field>
        <field name="arch" type="xml">
            <form string="Regla de Auditoría">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="action_type"/>
                        </group>
                        <group>
                            <field name="model_id" options="{'no_create': True}"/>
                            <field name="field_id" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Plantilla del Mensaje">
                            <field name="message_template" placeholder="Ej: Cambió de ${old_value} a ${new_value}"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_contract_modification_rule" model="ir.actions.act_window">
        <field name="name">Reglas de Auditoría de Contratos</field>
        <field name="res_model">contract.modification.rule</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_contract_modification_rule"
              name="Reglas de Modificación"
              parent="contract_management.contract_menu_config"
              action="action_contract_modification_rule"
              sequence="30"
              groups="contract_management.group_contract_modification_rule"/>
</odoo>
