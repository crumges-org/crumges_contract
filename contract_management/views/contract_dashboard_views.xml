<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- VISTA KANBAN DEL DASHBOARD -->
    <record id="contract_dashboard_kanban_view" model="ir.ui.view">
        <field name="name">contract.dashboard.card.kanban</field>
        <field name="model">contract.dashboard.card</field>
        <field name="arch" type="xml">
            <kanban class="oe_background_grey o_kanban_dashboard o_contract_dashboard" create="0" action="action_open_all" type="object">
                <field name="name"/>
                <field name="code"/>
                <field name="color"/>
                <field name="kanban_dashboard"/>
                <field name="has_contracts"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="#{kanban_color(record.color.raw_value)}">
                            <t t-value="JSON.parse(record.kanban_dashboard.raw_value)" t-set="dashboard"/>
                            
                            <!-- TITULO DE LA TARJETA -->
                            <div t-attf-class="o_kanban_card_header">
                                <div class="o_kanban_card_header_title">
                                    <div class="o_primary">
                                        <a type="object" name="action_open_all"><field name="name"/></a>
                                    </div>
                                </div>
                                <div class="o_kanban_manage_button_section">
                                    <a class="o_kanban_manage_toggle_button" href="#"><i class="fa fa-ellipsis-v" aria-label="Selection" role="img" title="Selection"/></a>
                                </div>
                            </div>
                            
                            <!-- CONTENIDO DE LA TARJETA -->
                            <div class="container o_kanban_card_content">
                                <div class="row">
                                    <!-- Columna Izquierda: Estados -->
                                    <div class="col-6 o_kanban_primary_left">
                                        <button type="object" name="action_open_in_progress" class="btn btn-primary">
                                            <span><t t-esc="dashboard.count_in_progress"/> En Curso</span>
                                        </button>
                                        <button type="object" name="action_open_draft" class="btn btn-secondary mt-2">
                                            <span><t t-esc="dashboard.count_draft"/> Borradores</span>
                                        </button>
                                    </div>
                                    
                                    <!-- Columna Derecha: Valores Proyectados -->
                                    <div class="col-6 o_kanban_primary_right">
                                        <div class="row" t-if="dashboard.count_in_progress > 0">
                                            <div class="col-12 text-end">
                                                <span title="Suma del importe base de todos los contratos activos">Próxima Generación</span>
                                            </div>
                                            <div class="col-12 text-end">
                                                <h2><t t-esc="dashboard.total_amount"/></h2>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- MENU DESPLEGABLE DE CONFIGURACION (opcional) -->
                            <div class="o_kanban_card_manage_pane dropdown-menu" role="menu">
                                <div class="o_kanban_card_manage_section">
                                    <div role="menuitem" class="o_kanban_card_manage_title">
                                        <span>Ver Contratos</span>
                                    </div>
                                    <div role="menuitem">
                                        <a type="object" name="action_open_draft">Borradores</a>
                                    </div>
                                    <div role="menuitem">
                                        <a type="object" name="action_open_in_progress">En Curso</a>
                                    </div>
                                    <div role="menuitem">
                                        <a type="object" name="action_open_done">Finalizados</a>
                                    </div>
                                    <div role="menuitem">
                                        <a type="object" name="action_open_all">Todos</a>
                                    </div>
                                </div>
                                <div t-if="widget.editable" class="o_kanban_card_manage_settings row">
                                    <div role="menuitem" aria-haspopup="true" class="col-8">
                                        <ul class="oe_kanban_colorpicker" data-field="color"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ACCION DEL DASHBOARD -->
    <record id="action_contract_dashboard" model="ir.actions.act_window">
        <field name="name">Tablero</field>
        <field name="res_model">contract.dashboard.card</field>
        <field name="view_mode">kanban,form</field>
        <!-- Solo mostrar tarjetas que tengan contratos o que queramos forzar -->
        <field name="domain">[('has_contracts', '=', True)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay contratos creados aún
            </p>
            <p>
                Crea un nuevo contrato o plantilla para comenzar.
            </p>
        </field>
    </record>

</odoo>
