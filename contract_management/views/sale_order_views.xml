<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_view_form_contract" model="ir.ui.view">
        <field name="name">sale.order.view.form.contract</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_contracts"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-book"
                    invisible="contract_count == 0">
                    <field name="contract_count" widget="statinfo" string="Contratos"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
