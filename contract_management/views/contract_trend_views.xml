<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="contract_dashboard_trend_view_tree" model="ir.ui.view">
        <field name="name">contract.dashboard.trend.tree</field>
        <field name="model">contract.dashboard.trend</field>
        <field name="arch" type="xml">
            <list string="Tendencias del Tablero">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="metric_type" />
                <field name="comparison_period" />
                <field name="operator" />
                <field name="percentage" />
                <field name="color" />
                <field name="active" widget="boolean_toggle" />
            </list>
        </field>
    </record>

    <record id="contract_dashboard_trend_view_form" model="ir.ui.view">
        <field name="name">contract.dashboard.trend.form</field>
        <field name="model">contract.dashboard.trend</field>
        <field name="arch" type="xml">
            <form string="Tendencia del Tablero">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" />
                        <h1><field
                                name="name"
                                placeholder="Ej. Buen crecimiento"
                            /></h1>
                    </div>
                    <group>
                        <group>
                            <field name="metric_type" />
                            <field name="comparison_period" />
                            <field name="sequence" />
                            <field name="active" widget="boolean_toggle" />
                        </group>
                        <group>
                            <label for="operator" string="Regla de Evaluación" />
                            <div>
                                <field name="operator" class="oe_inline" />
                                <field name="percentage" class="oe_inline" /> %
                            </div>
                            <field name="color" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Detalles Adicionales" name="details">
                            <field
                                name="details"
                                placeholder="Explica qué significa este porcentaje para el usuario..."
                            />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_contract_dashboard_trend" model="ir.actions.act_window">
        <field name="name">Tendencias y KPIs</field>
        <field name="res_model">contract.dashboard.trend</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea una nueva regla de tendencia
            </p>
            <p>
                Configura los indicadores de porcentaje de crecimiento para el tablero.
            </p>
        </field>
    </record>

    <!-- Menu -->
    <menuitem
        id="menu_contract_dashboard_trend"
        name="Tendencias y KPIs"
        parent="contract_management.contract_menu_config"
        action="action_contract_dashboard_trend"
        sequence="20"
    />
</odoo>
