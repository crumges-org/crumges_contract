<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- VISTA KANBAN DEL DASHBOARD -->
    <record id="contract_category_kanban_view" model="ir.ui.view">
        <field name="name">contract.category.kanban</field>
        <field name="model">contract.category</field>
        <field name="arch" type="xml">
            <kanban class="oe_background_grey o_kanban_dashboard o_contract_dashboard" action="action_open_all" type="object" js_class="contract_dashboard_kanban">
                <field name="name"/>
                <field name="base_type"/>
                <field name="color"/>
                <field name="count_draft"/>
                <field name="count_in_progress"/>
                <field name="count_done"/>
                <field name="count_cancelled"/>
                <field name="count_paused"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="#{kanban_color(record.color.raw_value)}">
                            
                            <!-- TITULO DE LA TARJETA -->
                            <div class="o_kanban_card_header d-flex justify-content-between align-items-start">
                                <div class="o_kanban_card_header_title">
                                    <div class="o_primary">
                                        <a type="object" name="action_open_all"><field name="name"/></a>
                                    </div>
                                    <div class="o_secondary text-muted">
                                        <field name="base_type"/>
                                    </div>
                                </div>
                                <div class="o_dropdown_kanban dropdown">
                                    <a class="dropdown-toggle o-no-caret btn" role="button" data-bs-toggle="dropdown" data-bs-display="static" href="#" aria-label="Dropdown menu" title="Dropdown menu">
                                        <span class="fa fa-ellipsis-v"/>
                                    </a>
                                    <div class="dropdown-menu" role="menu">
                                        <a role="menuitem" type="edit" class="dropdown-item">Editar Categoría</a>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- CONTENIDO DE LA TARJETA -->
                            <div class="container o_kanban_card_content">
                                <div class="row">
                                    <!-- Boton Principal -->
                                    <div class="col-12 mb-3">
                                        <button type="object" name="action_open_all" class="btn btn-primary w-100">
                                            Contratos (<t t-esc="record.count_draft.raw_value + record.count_in_progress.raw_value + record.count_done.raw_value + record.count_cancelled.raw_value + record.count_paused.raw_value"/>)
                                        </button>
                                    </div>
                                </div>
                                
                                <!-- Fila inferior con contadores -->
                                <div class="row text-center mt-2" style="border-top: 1px solid #dee2e6; padding-top: 10px;">
                                    <div class="col px-1" title="Borrador">
                                        <a type="object" name="action_open_draft" class="d-block text-decoration-none text-muted">
                                            <div class="fw-bold"><field name="count_draft"/></div>
                                            <small style="font-size: 0.7em;">Borrador</small>
                                        </a>
                                    </div>
                                    <div class="col px-1" title="En Curso" style="border-left: 1px solid #dee2e6;">
                                        <a type="object" name="action_open_in_progress" class="d-block text-decoration-none text-muted">
                                            <div class="fw-bold"><field name="count_in_progress"/></div>
                                            <small style="font-size: 0.7em;">En Curso</small>
                                        </a>
                                    </div>
                                    <div class="col px-1" title="Pausados" style="border-left: 1px solid #dee2e6;">
                                        <a type="object" name="action_open_paused" class="d-block text-decoration-none text-muted">
                                            <div class="fw-bold"><field name="count_paused"/></div>
                                            <small style="font-size: 0.7em;">Pausados</small>
                                        </a>
                                    </div>
                                    <div class="col px-1" title="Finalizados" style="border-left: 1px solid #dee2e6;">
                                        <a type="object" name="action_open_done" class="d-block text-decoration-none text-muted">
                                            <div class="fw-bold"><field name="count_done"/></div>
                                            <small style="font-size: 0.7em;">Finalizados</small>
                                        </a>
                                    </div>
                                    <div class="col px-1" title="Cancelados" style="border-left: 1px solid #dee2e6;">
                                        <a type="object" name="action_open_cancelled" class="d-block text-decoration-none text-muted">
                                            <div class="fw-bold"><field name="count_cancelled"/></div>
                                            <small style="font-size: 0.7em;">Cancelados</small>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Vista Formulario de Categoría -->
    <record id="contract_category_form_view" model="ir.ui.view">
        <field name="name">contract.category.form</field>
        <field name="model">contract.category</field>
        <field name="arch" type="xml">
            <form string="Categoría de Contrato">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="Ej. Suscripciones de Software"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="base_type"/>
                            <field name="contract_template_id"/>
                        </group>
                        <group>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="color" widget="color_picker"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ACCION DEL DASHBOARD -->
    <record id="action_contract_dashboard" model="ir.actions.act_window">
        <field name="name">Tablero</field>
        <field name="res_model">contract.category</field>
        <field name="view_mode">kanban,form</field>
        <field name="domain">[]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay categorías creados aún
            </p>
            <p>
                Crea una nueva categoría para organizar tus contratos.
            </p>
        </field>
    </record>

</odoo>

