<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Sobrescribir la vista de portal base de OCA -->
    <template id="portal_contract_page_inherit" inherit_id="contract.portal_contract_page" priority="99">
        <xpath expr="//t[@t-call='portal.portal_layout']" position="replace">
            <t t-call="portal.portal_layout">
                <t t-set="o_portal_fullwidth_alert" groups="sales_team.group_sale_salesman">
                    <t t-call="portal.portal_back_in_edit_mode">
                        <t t-set="backend_url" t-value="'/web#return_label=Website&amp;model=contract.contract&amp;id=%s&amp;view_type=form' % (contract.id)" />
                    </t>
                </t>
                <div class="container o_portal_sidebar mt-3 mb-5">
                    <div class="row">
                    <!-- Sidebar -->
                    <t t-call="portal.portal_record_sidebar" id="contract_portal_sidebar">
                        <t t-set="classes" t-value="'col-12 col-lg-4 col-xxl-3 d-print-none'"/>
                        <t t-set="entries">
                            <div class="d-flex flex-column gap-4 mt-3">
                                <div class="d-flex flex-column gap-2" id="contract_sidebar_button">
                                    <a t-attf-href="/report/pdf/contract.report_contract/#{contract.id}?access_token=#{contract.access_token}" class="btn btn-primary w-100 text-start" title="Descargar PDF">
                                        <i class="fa fa-download me-1"/> Descargar PDF
                                    </a>
                                    <a t-if="contract.invoice_count > 0" t-attf-href="/my/invoices" class="btn btn-primary w-100 text-start">
                                        <i class="fa fa-file-text-o me-1"/> <t t-esc="contract.invoice_count"/> Facturas
                                    </a>
                                    <a t-if="contract.sale_count > 0" t-attf-href="/my/orders" class="btn btn-primary w-100 text-start">
                                        <i class="fa fa-shopping-cart me-1"/> <t t-esc="contract.sale_count"/> Ventas
                                    </a>
                                </div>
                                <t t-if="contract.partner_id">
                                    <div class="d-flex flex-column gap-2">
                                        <h6><small class="text-muted">Cliente</small></h6>
                                        <div class="d-flex mb-3">
                                            <div class="flex-shrink-0 pe-2">
                                                <img t-if="contract.partner_id.image_128" class="rounded-circle mt-1 o_portal_contact_img" t-att-src="image_data_uri(contract.partner_id.image_128)" alt="Contact" style="width: 40px; height: 40px;" />
                                                <img t-else="" class="rounded-circle mt-1 o_portal_contact_img" src="/web/static/src/img/user_menu_avatar.png" alt="Contact" style="width: 40px; height: 40px;" />
                                            </div>
                                            <div class="flex-grow-1">
                                                <address t-field="contract.partner_id" t-options='{"widget": "contact", "fields": ["name", "email", "phone"]}' />
                                            </div>
                                        </div>
                                    </div>
                                </t>
                                <t t-if="contract.user_id">
                                    <div class="d-flex flex-column gap-2 mt-3">
                                        <h6><small class="text-muted">Responsable</small></h6>
                                        <div class="d-flex mb-3">
                                            <div class="flex-shrink-0 pe-2">
                                                <img t-if="contract.user_id.image_128" class="rounded-circle mt-1 o_portal_contact_img" t-att-src="image_data_uri(contract.user_id.image_128)" alt="Contact" style="width: 40px; height: 40px;" />
                                                <img t-else="" class="rounded-circle mt-1 o_portal_contact_img" src="/web/static/src/img/user_menu_avatar.png" alt="Contact" style="width: 40px; height: 40px;" />
                                            </div>
                                            <div class="flex-grow-1">
                                                <address t-field="contract.user_id" t-options='{"widget": "contact", "fields": ["name", "email", "phone"]}' />
                                            </div>
                                        </div>
                                    </div>
                                </t>
                                <t t-if="contract.tag_ids">
                                    <div class="d-flex flex-column gap-2 mt-2">
                                        <h6><small class="text-muted">Etiquetas</small></h6>
                                        <div class="d-flex flex-wrap gap-1">
                                            <t t-set="color_map" t-value="{1: 'text-bg-danger', 2: 'text-bg-warning', 3: 'text-bg-warning', 4: 'text-bg-info', 5: 'text-bg-dark', 6: 'text-bg-danger', 7: 'text-bg-info', 8: 'text-bg-primary', 9: 'text-bg-danger', 10: 'text-bg-success', 11: 'text-bg-secondary'}"/>
                                            <t t-foreach="contract.tag_ids" t-as="tag">
                                                <span t-attf-class="badge rounded-pill #{color_map.get(tag.color, 'text-bg-light')}">
                                                    <t t-esc="tag.name"/>
                                                </span>
                                            </t>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </t>
                    </t>

                    <!-- Page content -->
                    <div id="contract_content" class="col-12 col-lg-8 col-xxl-9 mt-5 mt-lg-0">
                        <div class="card">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <h5 class="mb-0">
                                    <span>Contrato - <span t-field="contract.name" /></span>
                                </h5>
                                <span t-attf-class="badge rounded-pill #{'text-bg-success' if contract.state in ['in_progress', 'done'] else 'text-bg-secondary'}">
                                    <span t-field="contract.state" />
                                </span>
                            </div>
                            <div class="card-body">
                                <div id="general_information">
                                    <div class="row mb-4">
                                        <div class="col-12 col-md-6">
                                            <div><strong>Fecha de Inicio:</strong> <span t-field="contract.date_start" t-options='{"widget": "date"}'/></div>
                                            <div class="text-muted mt-1 small">
                                                <i class="fa fa-refresh me-1"/>
                                                <t t-if="contract.contract_type == 'sale' and contract.generation_type == 'invoice'">Facturas de venta</t>
                                                <t t-elif="contract.contract_type == 'sale' and contract.generation_type == 'sale'">Pedidos de venta</t>
                                                <t t-elif="contract.contract_type == 'purchase' and contract.generation_type == 'invoice'">Facturas de compra</t>
                                                <t t-else="">Contrato</t>
                                                
                                                <t t-if="not contract.line_recurrence">
                                                    (cada <span t-field="contract.recurring_interval"/> <span t-field="contract.recurring_rule_type" class="text-lowercase"/>)
                                                </t>
                                                <t t-else="">
                                                    (Múltiples frecuencias por línea)
                                                </t>
                                            </div>
                                        </div>
                                        <div class="col-12 col-md-6 mt-2" t-if="contract.recurring_next_date and not contract.line_recurrence">
                                            <strong>Próxima Generación:</strong> <span t-field="contract.recurring_next_date" t-options='{"widget": "date"}'/>
                                        </div>
                                        <div class="col-12 col-md-6 mt-2" t-if="contract.code">
                                            <strong>Referencia:</strong> <span t-field="contract.code" />
                                        </div>
                                        <div class="col-12 col-md-6" t-if="contract.date_end">
                                            <strong>Fecha de Finalización:</strong> <span t-field="contract.date_end" t-options='{"widget": "date"}'/>
                                        </div>
                                    </div>

                                    <div id="item_details" class="table-responsive">
                                        <table class="table table-sm" id="sales_order_table">
                                            <thead class="bg-100">
                                                <tr>
                                                    <th name="th_name" class="text-left">Descripción</th>
                                                    <th name="th_quantity" class="text-end">Cant.</th>
                                                    <th name="th_price_unit" class="text-end">Precio</th>
                                                    <th name="th_discount" class="text-end">Desc. (%)</th>
                                                    <th name="th_frequency" class="text-start" t-if="contract.line_recurrence">Frecuencia</th>
                                                    <th name="th_next_date" class="text-start" t-if="contract.line_recurrence">Próxima Gen.</th>
                                                    <th name="th_price_subtotal" class="text-end">Sub Total</th>
                                                </tr>
                                            </thead>
                                            <tbody class="contract_tbody">
                                                <t t-foreach="contract.contract_line_ids" t-as="line">
                                                    <tr t-att-class="'bg-200 font-weight-bold o_line_section' if line.display_type == 'line_section' else 'font-italic o_line_note' if line.display_type == 'line_note' else 'text-muted' if line.is_canceled else ''">
                                                        <t t-if="not line.display_type">
                                                            <td name="td_name"><span t-field="line.name" /></td>
                                                            <td name="td_quantity" class="text-end"><span t-field="line.quantity" /></td>
                                                            <td name="td_price_unit" class="text-end"><span t-field="line.price_unit" t-options='{"widget": "monetary", "display_currency": contract.currency_id}' /></td>
                                                            <td name="td_discount" class="text-end"><span t-field="line.discount" /></td>
                                                            <td name="td_frequency" t-if="contract.line_recurrence">
                                                                <t t-if="line.recurring_interval">
                                                                    <span t-field="line.recurring_interval"/> <span t-field="line.recurring_rule_type" class="text-lowercase"/>
                                                                </t>
                                                            </td>
                                                            <td name="td_next_date" t-if="contract.line_recurrence">
                                                                <span t-field="line.recurring_next_date" t-options='{"widget": "date"}'/>
                                                            </td>
                                                            <td name="td_price_subtotal" class="text-end"><span t-field="line.price_subtotal" t-options='{"widget": "monetary", "display_currency": contract.currency_id}' /></td>
                                                        </t>
                                                        <t t-if="line.display_type == 'line_section'">
                                                            <td colspan="99"><span t-field="line.name" /></td>
                                                        </t>
                                                        <t t-if="line.display_type == 'line_note'">
                                                            <td colspan="99"><span t-field="line.name" /></td>
                                                        </t>
                                                    </tr>
                                                </t>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Modifications History -->
                        <section t-if="contract.modification_ids" class="s_timeline pt24 pb48 o_colored_level" data-snippet="s_timeline">
                            <div class="container s_timeline_line">
                                <t t-set="last_modification_date" t-value="False" />
                                <div class="s_timeline_row d-block d-md-flex flex-row" t-foreach="contract.modification_ids" t-as="modification">
                                    <div class="s_timeline_date">
                                        <t t-if="not last_modification_date or last_modification_date!=modification.date">
                                            <t t-set="last_modification_date" t-value="modification.date" />
                                            <span class="bg-white">
                                                <b class="o_default_snippet_text" t-esc="last_modification_date" t-options='{"widget": "date"}' />
                                            </span>
                                        </t>
                                    </div>
                                    <div class="s_timeline_content s_timeline_content_left d-flex">
                                        <div class="s_timeline_card s_card card bg-white w-100" data-snippet="s_card">
                                            <div class="card-body py-2">
                                                <div class="card-text o_default_snippet_text" t-field="modification.description" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="s_timeline_content s_timeline_content_right" />
                                </div>
                            </div>
                        </section>

                        <!-- chatter -->
                        <div id="contract_communication" class="mt-4">
                            <h2>Comunicación</h2>
                            <t t-call="portal.message_thread">
                                <t t-set="object" t-value="contract" />
                                <t t-set="token" t-value="contract.access_token" />
                                <t t-set="pid" t-value="pid" />
                                <t t-set="hash" t-value="hash" />
                            </t>
                        </div>
                    </div>
                    </div>
                </div>
            </t>
        </xpath>
    </template>

    <!-- Enlace al contrato desde la Factura (Portal) -->
    <template id="portal_invoice_page_inherit_contract" inherit_id="account.portal_invoice_page">
        <xpath expr="//div[hasclass('o_download_pdf')]" position="before">
            <t t-if="invoice.contract_ids">
                <t t-foreach="invoice.contract_ids" t-as="contract">
                    <a t-attf-href="/my/contracts/#{contract.id}?access_token=#{contract.access_token}" class="btn btn-primary flex-grow-1 mb-2" title="Ver Contrato">
                        <i class="fa fa-file-text-o me-1"/> Ver Contrato <t t-esc="contract.name"/>
                    </a>
                </t>
            </t>
        </xpath>
    </template>

    <!-- Enlace al contrato desde la Venta (Portal) -->
    <template id="sale_order_portal_template_inherit_contract" inherit_id="sale.sale_order_portal_template">
        <xpath expr="//div[hasclass('o_download_pdf')]" position="before">
            <t t-if="sale_order.contract_ids">
                <t t-foreach="sale_order.contract_ids" t-as="contract">
                    <a t-attf-href="/my/contracts/#{contract.id}?access_token=#{contract.access_token}" class="btn btn-primary flex-grow-1 mb-2" title="Ver Contrato">
                        <i class="fa fa-file-text-o me-1"/> Ver Contrato <t t-esc="contract.name"/>
                    </a>
                </t>
            </t>
        </xpath>
    </template>
</odoo>
